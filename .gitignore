node_modules/
research/videos/*.mp4
docs/preview-*.png

# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
credentials.md

# ── Build output — regenerated by `npm run build` on every deploy ────────
dist/
apps/web/dist/

# ── Runtime data — uploads, cached/generated assets. Ephemeral on a
# platform without a persistent volume, and too large to version anyway
# (this alone has passed a gigabyte locally from cached online-library
# downloads). Put a Railway Volume here if uploaded/generated content needs
# to survive a redeploy. ────────────────────────────────────────────────
apps/api/storage/

# Screenshots and run logs written by the test-*.mjs scripts at the repo
# root — scratch debugging output, not the app's own runtime data.
/storage/

# ── Large source material not needed to build or run the app ─────────────
# The 112 MB source model behind the seeded Rotana venue — already
# processed down to ~2.5 MB and stored under apps/api/storage/assets/venues,
# which itself is not committed (see above). Re-run
# `npm run seed:rotana --workspace=apps/api` with this file present to
# regenerate it.
/rotana for apoli.glb
# Generated-image originals; the resized copies actually served live in
# apps/web/public (see scripts/artwork.mjs).
artwork/
# Scratch research material (frame captures, exploratory scripts) — not
# part of the product.
research/

# ── Editor/OS noise ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
