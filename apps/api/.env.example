# Copy to `.env` for local development. On Railway, set these as service
# variables instead — this file is never read there.

NODE_ENV=development
# Railway's MySQL plugin provides this; reference it from the app service as
# ${{MySQL.MYSQL_URL}} (the exact variable name Railway assigns).
DATABASE_URL=mysql://user:password@localhost:3307/novira
PORT=4100
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5174
UPLOAD_DIR=./storage/uploads
ASSET_DIR=./storage/assets
# The app's own public URL. On Railway, the domain it assigns after the first
# deploy (Settings → Networking → Generate Domain).
PUBLIC_BASE_URL=http://localhost:4100

# ── AI providers (all optional — each feature that needs one says so on screen) ──
TRIPO_API_KEY=
TRIPO_CLIENT_ID=
OPENAI_API_KEY=
NANOBANANA_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe. Leave both blank to run billing through the approval queue instead
# (a real mode, not a stub — invoiced deals follow the same path).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Online asset libraries ──────────────────────────────────────────────
# Every provider without a key here still works — Poly Haven, ambientCG,
# Poly Pizza, Khronos, NASA, Open Source 3D and Pinterest need nothing.
# SKETCHFAB_API_TOKEN=
# BLENDERKIT_API_KEY=
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# EUROPEANA_API_KEY=
# SMITHSONIAN_API_KEY=
# THINGIVERSE_TOKEN=
# MYMINIFACTORY_KEY=
# POLY_PIZZA_API_KEY=

# Background warming of the asset shelves. "off" disables it entirely.
ASSET_WARM=off
ASSET_WARM_DELAY_MS=15000
ASSET_WARM_INTERVAL_MS=3600000
